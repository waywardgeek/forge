  func deep_copy_func_decl(f: FuncDecl, type_map: Dict<Sym, string>) -> FuncDecl
    source: desugar.ly:125
    doc: "Deep copy utility for FuncDecl nodes. Copies all fields (name, flags, receiver_type, return_type, body, span) and child arrays (type params, params, where clauses). Applies simple type-param substitution via type_map during copy. Body is deep-copied via deep_copy_block. Used by pass 0 (desugar_interface_extends) for inheritance and pass 5 (desugar_default_impls) for erased interface default extraction (with empty type_map to avoid aliasing)."

