    method check_structural_satisfaction(self, class_name: string, iface_name: string) -> bool
      source: checker.ly:5681
      why: "Checks if a class structurally satisfies an interface — i.e. has all abstract methods the interface requires. Used by is_assignable as a lazy structural subtyping check. Handles qualified interface names ('DirectedGraph.N') by splitting at the dot to extract base interface and member name, then delegates to check_structural_chase for multi-param signature walking."
    method check_structural_chase(self, anchor_class: string, iface: InterfaceDecl, expected_member: string) -> bool
      source: checker.ly:5721
      why: "Multi-param signature chase for interface family satisfaction. Given an anchor class and a target family member name, walks the interface's method signatures to discover which concrete classes satisfy which family param slots. Iterates interface type params and methods, checking whether the anchor class has each method whose receiver matches the expected member param. Returns true if all required methods for the expected_member slot are present on anchor_class."

