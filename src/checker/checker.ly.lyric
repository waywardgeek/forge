    method check_method_call(self, call_expr: Expr, receiver: Expr, method: Sym, type_args: [TypeExpr], args: [Expr]) -> Type
      source: checker.ly:3870
      why: "Resolves method calls via a 3-step resolution chain: (1) concrete class method — direct lookup on receiver TypeInfo.methods; (2) interface default method — if receiver is interface-typed, walks family member TypeInfos registered by Phase 1.5c for default methods; (3) free function UFCS — looks up method name in scope as a free function and prepends receiver as first arg. Also handles dotted-scope rewriting for relational sub-scopes (obj.label.method → obj.__label_method)."
